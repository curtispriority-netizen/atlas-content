{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "atlas/edition.schema.json",
  "title": "Atlas weekly edition",
  "type": "object",
  "required": [
    "schema_version",
    "edition_id",
    "published_at",
    "verdict",
    "quiet_week",
    "items",
    "on_the_radar",
    "filtered_out",
    "sources"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "edition_id": {
      "type": "string",
      "pattern": "^[0-9]{4}-W[0-9]{2}$"
    },
    "published_at": {
      "type": "string",
      "format": "date-time"
    },
    "sample": {
      "type": "boolean",
      "description": "True only for hand-made test editions."
    },
    "verdict": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "caveat": {
      "type": "string",
      "maxLength": 300
    },
    "quiet_week": {
      "type": "boolean"
    },
    "items": {
      "type": "array",
      "minItems": 0,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/study"
      }
    },
    "measure_of_week": {
      "$ref": "#/$defs/measure"
    },
    "on_the_radar": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "title",
          "note",
          "source_ids"
        ],
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "filtered_out": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "title",
          "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    }
  },
  "$defs": {
    "confidence": {
      "enum": [
        "certain",
        "likely",
        "guessing"
      ]
    },
    "full_text": {
      "type": "object",
      "required": [
        "status",
        "worth_getting"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "read",
            "open_access_unread",
            "paywalled"
          ]
        },
        "worth_getting": {
          "type": "boolean"
        },
        "why": {
          "type": "string"
        },
        "routes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "key_number": {
      "type": "object",
      "required": [
        "value",
        "label"
      ],
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": "string"
        },
        "label": {
          "type": "string"
        }
      }
    },
    "study": {
      "type": "object",
      "required": [
        "type",
        "item_id",
        "region",
        "title",
        "evidence_tag",
        "confidence",
        "impact",
        "impact_line",
        "summary",
        "limits",
        "read_level",
        "full_text",
        "source_ids"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "study"
        },
        "item_id": {
          "type": "string",
          "pattern": "^[0-9]{4}-W[0-9]{2}-[0-9]+$"
        },
        "region": {
          "enum": [
            "lumbar",
            "cervical",
            "lower limb",
            "hip and groin"
          ]
        },
        "title": {
          "type": "string",
          "maxLength": 140
        },
        "first_published": {
          "type": "string",
          "description": "Year or date of the original paper. Lets backfill items show their age."
        },
        "evidence_tag": {
          "enum": [
            "established",
            "emerging",
            "practice_gap"
          ]
        },
        "evidence_note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "confidence_note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "impact": {
          "enum": [
            "changes_what_i_say",
            "set_expectations",
            "know_dont_act"
          ]
        },
        "impact_line": {
          "type": "string",
          "maxLength": 300
        },
        "summary": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ],
          "description": "Format 2: 3-5 bullets. Older cards: 4-6 sentences."
        },
        "pico": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "p": {
              "type": "string"
            },
            "i": {
              "type": "string"
            },
            "c": {
              "type": "string"
            },
            "o": {
              "type": "string"
            }
          }
        },
        "key_numbers": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/key_number"
          }
        },
        "limits": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "read_level": {
          "enum": [
            "full_text",
            "abstract",
            "synopsis"
          ]
        },
        "full_text": {
          "$ref": "#/$defs/full_text"
        },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "condition": {
          "type": "string",
          "description": "Which playbook condition this item serves, e.g. 'Discogenic low back pain', 'Referred neck pain', 'Achilles tendinopathy', 'Adductor-related groin pain'."
        },
        "playbook_step": {
          "enum": [
            "screen",
            "assess",
            "classify",
            "measure",
            "treat",
            "educate"
          ]
        },
        "bottom_line": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ],
          "description": "2-3 sentences a clinician can act on."
        },
        "methods": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "design": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ]
            },
            "setting": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ]
            },
            "participants": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ]
            },
            "intervention": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ]
            },
            "comparator": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ]
            },
            "follow_up": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ]
            },
            "primary_outcome": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ]
            }
          }
        },
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "outcome",
              "result"
            ],
            "additionalProperties": false,
            "properties": {
              "outcome": {
                "type": "string"
              },
              "timepoint": {
                "type": "string"
              },
              "result": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                ]
              },
              "effect": {
                "type": "string",
                "description": "Effect size with 95% CI, e.g. MD -1.2 (95% CI -2.0 to -0.4)"
              },
              "meaning": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                ]
              },
              "detail": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                ],
                "description": "Longer explanation and provenance, shown only on tap."
              },
              "verdict": {
                "enum": [
                  "meaningful",
                  "below_mcid",
                  "no_difference",
                  "unclear",
                  "descriptive"
                ]
              }
            }
          }
        },
        "how_to_apply": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Concrete steps: dose, frequency, progression, what to say."
        },
        "applies_to": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "not_for": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "appraisal": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "certainty": {
              "enum": [
                "high",
                "moderate",
                "low",
                "very low"
              ]
            },
            "strengths": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "weaknesses": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "funding_conflicts": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ]
            },
            "appraised_from": {
              "enum": [
                "full_text",
                "abstract"
              ],
              "description": "Risk-of-bias domains can't be judged properly from an abstract."
            },
            "tool": {
              "type": "string",
              "description": "Design-matched tool: RoB 2 (RCT), ROBINS-I (non-randomised), AMSTAR 2 (systematic review), QUADAS-2 (diagnostic accuracy), QUIPS (prognosis), COSMIN (measurement properties), JBI (other)."
            },
            "overall_risk_of_bias": {
              "enum": [
                "low",
                "some concerns",
                "high",
                "not assessable"
              ]
            },
            "domains": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "domain",
                  "judgement",
                  "reason"
                ],
                "additionalProperties": false,
                "properties": {
                  "domain": {
                    "type": "string"
                  },
                  "judgement": {
                    "enum": [
                      "low",
                      "some concerns",
                      "high",
                      "unclear"
                    ]
                  },
                  "reason": {
                    "type": "string"
                  },
                  "support": {
                    "type": "string",
                    "description": "Where in the paper the reason comes from (section/page/table) and what it says, paraphrased. 'Not reported' if absent."
                  }
                }
              }
            },
            "grade": {
              "type": "array",
              "description": "GRADE domains for the primary outcome.",
              "items": {
                "type": "object",
                "required": [
                  "domain",
                  "judgement",
                  "reason"
                ],
                "additionalProperties": false,
                "properties": {
                  "domain": {
                    "enum": [
                      "risk of bias",
                      "inconsistency",
                      "indirectness",
                      "imprecision",
                      "publication bias"
                    ]
                  },
                  "judgement": {
                    "enum": [
                      "not serious",
                      "serious",
                      "very serious",
                      "not applicable"
                    ]
                  },
                  "reason": {
                    "type": "string"
                  }
                }
              }
            },
            "clinical_significance": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ]
            },
            "comparator_fairness": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ]
            },
            "alternative_explanations": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ]
            },
            "spin": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ]
            },
            "fit_with_evidence": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ]
            },
            "external_validity": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ]
            },
            "would_change_my_mind": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ]
            },
            "verification": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status"
              ],
              "properties": {
                "status": {
                  "enum": [
                    "agrees",
                    "disagreements",
                    "not checked"
                  ]
                },
                "checked_by": {
                  "type": "string",
                  "description": "e.g. 'independent second pass (full text)'"
                },
                "checked_at": {
                  "type": "string"
                },
                "disagreements": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "item",
                      "first",
                      "second",
                      "why"
                    ],
                    "properties": {
                      "item": {
                        "type": "string"
                      },
                      "first": {
                        "type": "string"
                      },
                      "second": {
                        "type": "string"
                      },
                      "why": {
                        "type": "string"
                      },
                      "resolved": {
                        "type": "string",
                        "description": "Final call and reason, or 'left open'."
                      }
                    }
                  }
                },
                "external": {
                  "type": "array",
                  "description": "Expert ratings of this same paper found elsewhere.",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "source",
                      "rating"
                    ],
                    "properties": {
                      "source": {
                        "type": "string",
                        "description": "PEDro, Cochrane review, other systematic review"
                      },
                      "rating": {
                        "type": "string"
                      },
                      "note": {
                        "type": "string"
                      },
                      "url": {
                        "type": "string"
                      },
                      "agrees": {
                        "type": "boolean"
                      }
                    }
                  }
                },
                "external_searched": {
                  "type": "string",
                  "description": "Where you looked for external ratings, so 'none found' is meaningful."
                }
              }
            }
          }
        },
        "patient_explanation": {
          "type": "string",
          "description": "1-2 sentences in plain patient language."
        },
        "open_questions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "key_findings": {
          "type": "array",
          "minItems": 3,
          "maxItems": 5,
          "items": {
            "type": "string"
          },
          "description": "Format 2: the glance layer. See CARD_STYLE.md."
        },
        "format": {
          "enum": [
            1,
            2
          ],
          "description": "2 = CARD_STYLE.md bullet structure (caps enforced by validate.py)."
        }
      }
    },
    "measure": {
      "type": "object",
      "required": [
        "type",
        "measure_id",
        "kind",
        "name",
        "full_name",
        "region",
        "bottom_line",
        "what_it_measures",
        "numbers",
        "pitfalls",
        "source_ids"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "measure"
        },
        "measure_id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "kind": {
          "enum": [
            "prom",
            "performance_test",
            "clinical_test"
          ]
        },
        "name": {
          "type": "string"
        },
        "full_name": {
          "type": "string"
        },
        "region": {
          "type": "string"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "bottom_line": {
          "type": "string"
        },
        "what_it_measures": {
          "type": "string"
        },
        "how_to_score": {
          "type": "string"
        },
        "variants": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "formula"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "formula": {
                "type": "string"
              },
              "note": {
                "type": "string"
              }
            }
          }
        },
        "numbers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "metric",
              "value",
              "population",
              "source_id"
            ],
            "additionalProperties": false,
            "properties": {
              "metric": {
                "type": "string"
              },
              "value": {
                "type": "string"
              },
              "population": {
                "type": "string"
              },
              "source_id": {
                "type": "string"
              }
            }
          }
        },
        "when_to_use": {
          "type": "string"
        },
        "pitfalls": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "licence": {
          "type": "string"
        },
        "official_link": {
          "type": "string"
        },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "id",
        "citation",
        "verified"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "citation": {
          "type": "string"
        },
        "doi": {
          "type": "string"
        },
        "pmid": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "verified": {
          "type": "boolean",
          "description": "True only if the weekly task fetched the record itself and the details matched."
        }
      }
    }
  }
}
